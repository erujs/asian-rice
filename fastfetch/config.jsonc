// ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/aerith-terminal.png",
    "height": 15,
    "padding": {
      "top": 5,
      "right": 1
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;204;251;241" // Teal Keys
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "\u001b[38;2;204;251;241m{user-name}@{host-name}\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;204;251;241m───────────────────────────────────────────────────────\u001b[0m"
    },
    "break",
    {
      "type": "uptime",
      "keyColor": "38;2;204;251;241",
      "outputColor": "38;2;204;251;241"
    },
    {
      "type": "os",
      "keyColor": "38;2;204;251;241",
      "format": "\u001b[38;2;204;251;241m{name} {version}\u001b[0m"
    },
    {
      "type": "kernel",
      "keyColor": "38;2;204;251;241",
      "outputColor": "38;2;204;251;241"
    },
    {
      "type": "shell",
      "keyColor": "38;2;204;251;241",
      "outputColor": "38;2;204;251;241"
    },
    {
      "type": "terminal",
      "keyColor": "38;2;204;251;241",
      "outputColor": "38;2;204;251;241"
    },
    {
      "type": "terminalfont",
      "keyColor": "38;2;204;251;241",
      "format": "\u001b[38;2;204;251;241m{name}\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;204;251;241m───────────────────────────────────────────────────────\u001b[0m"
    },
    "break",
    {
      "type": "de",
      "keyColor": "38;2;204;251;241",
      "outputColor": "38;2;204;251;241"
    },
    {
      "type": "wm",
      "keyColor": "38;2;204;251;241",
      "outputColor": "38;2;204;251;241"
    },
    {
      "type": "cpu",
      "keyColor": "38;2;204;251;241",
      "format": "\u001b[38;2;204;251;241m{name}\u001b[0m"
    },
    {
      "type": "gpu",
      "keyColor": "38;2;204;251;241",
      "format": "\u001b[38;2;204;251;241m{name}\u001b[0m"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;204;251;241m───────────────────────────────────────────────────────\u001b[0m"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "block": {
        "range": [
          1,
          6
        ]
      }
    }
  ]
}